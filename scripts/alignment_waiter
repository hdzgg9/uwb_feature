#!/usr/bin/env python3
# 정렬 완료 확인하는 노드
import sys

import rclpy
from rclpy.node import Node
from rclpy.qos import QoSProfile, ReliabilityPolicy, DurabilityPolicy
from std_msgs.msg import Bool


class AlignmentWaiter(Node):
    def __init__(self):
        super().__init__('alignment_waiter')
        qos = QoSProfile(
            depth=1,
            reliability=ReliabilityPolicy.RELIABLE,
            durability=DurabilityPolicy.TRANSIENT_LOCAL)
        self.create_subscription(Bool, '/alignment_ready', self.on_ready, qos)
        self.get_logger().info(
            'Robots remain stationary until /alignment_ready=true.')

    def on_ready(self, msg):
        if msg.data:
            self.get_logger().info(
                'Alignment ready; allowing experiment launch to start frontier.')
            raise SystemExit(0)


def main():
    rclpy.init()
    node = AlignmentWaiter()
    try:
        rclpy.spin(node)
    except SystemExit:
        node.destroy_node()
        rclpy.shutdown()
        sys.exit(0)
    except KeyboardInterrupt:
        pass


if __name__ == '__main__':
    main()
