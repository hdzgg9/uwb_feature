#!/usr/bin/env python3
import math

import numpy as np
import rclpy
from geometry_msgs.msg import Twist
from rclpy.node import Node
from sensor_msgs.msg import LaserScan


class ScanWander(Node):
    def __init__(self):
        super().__init__('scan_wander')
        self.declare_parameter('robot_name', 'tb3_0')
        self.robot = self.get_parameter('robot_name').value
        self.pub = self.create_publisher(Twist, f'/{self.robot}/cmd_vel', 10)
        self.create_subscription(
            LaserScan, f'/{self.robot}/scan', self.on_scan, 10)

    def on_scan(self, msg):
        ranges = np.asarray(msg.ranges, dtype=float)
        angles = msg.angle_min + np.arange(len(ranges)) * msg.angle_increment
        ranges[~np.isfinite(ranges)] = msg.range_max
        front = ranges[np.abs(angles) < math.radians(35)]
        left = ranges[(angles > 0.25) & (angles < 1.55)]
        right = ranges[(angles < -0.25) & (angles > -1.55)]
        command = Twist()
        if front.size and np.min(front) < 0.65:
            command.angular.z = 0.65 if np.mean(left) > np.mean(right) else -0.65
        else:
            command.linear.x = 0.14
            command.angular.z = 0.10 if self.robot == 'tb3_0' else -0.08
        self.pub.publish(command)


def main():
    rclpy.init()
    node = ScanWander()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.pub.publish(Twist())
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
