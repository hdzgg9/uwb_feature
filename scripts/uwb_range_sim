#!/usr/bin/env python3
import math

import numpy as np
import rclpy
from gazebo_msgs.msg import ModelStates
from rclpy.node import Node
from sensor_msgs.msg import Range


class UwbRangeSim(Node):
    def __init__(self):
        super().__init__('uwb_range_sim')
        self.declare_parameter('robot_name', 'tb3_0')
        self.declare_parameter('anchor_x', 0.0)
        self.declare_parameter('anchor_y', 0.0)
        self.declare_parameter('noise_stddev', 0.05)
        self.declare_parameter('update_rate', 10.0)
        self.declare_parameter('random_seed', 7)
        self.robot = self.get_parameter('robot_name').value
        self.ax = float(self.get_parameter('anchor_x').value)
        self.ay = float(self.get_parameter('anchor_y').value)
        self.sigma = float(self.get_parameter('noise_stddev').value)
        seed = int(self.get_parameter('random_seed').value)
        self.rng = np.random.default_rng(seed + (1 if self.robot == 'tb3_1' else 0))
        self.pub = self.create_publisher(Range, f'/{self.robot}/uwb_range', 10)
        self.position = None
        self.create_subscription(
            ModelStates, '/gazebo/model_states', self.on_model_states, 10)
        rate = max(0.1, float(self.get_parameter('update_rate').value))
        self.create_timer(1.0 / rate, self.publish_range)

    def on_model_states(self, msg):
        try:
            index = msg.name.index(self.robot)
        except ValueError:
            return
        pose = msg.pose[index]
        self.position = (pose.position.x, pose.position.y)

    def publish_range(self):
        if self.position is None:
            return
        distance = math.hypot(
            self.position[0] - self.ax, self.position[1] - self.ay)
        msg = Range()
        msg.header.stamp = self.get_clock().now().to_msg()
        msg.header.frame_id = 'world'
        msg.radiation_type = Range.INFRARED
        msg.field_of_view = 2.0 * math.pi
        msg.min_range = 0.0
        msg.max_range = 30.0
        msg.range = float(max(0.0, distance + self.rng.normal(0.0, self.sigma)))
        self.pub.publish(msg)


def main():
    rclpy.init()
    node = UwbRangeSim()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
