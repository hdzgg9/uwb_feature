<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="uwb_feature_world">
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>20.0</update_rate>
    </plugin>
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <physics type="ode"><real_time_update_rate>1000</real_time_update_rate></physics>

    <model name="anchor_A0">
      <static>true</static><pose>0 0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.07</radius><length>0.7</length></cylinder></geometry>
        </collision>
        <visual name="visual"><geometry><cylinder><radius>0.07</radius><length>0.7</length></cylinder></geometry>
          <material><ambient>0.1 0.2 0.9 1</ambient><diffuse>0.1 0.2 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <model name="landmark_0"><static>true</static><pose>0 3.3 0.5 0 0 0</pose><link name="link">
      <collision name="c"><geometry><cylinder><radius>0.15</radius><length>1</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.15</radius><length>1</length></cylinder></geometry><material><ambient>1 .5 0 1</ambient></material></visual>
    </link></model>
    <model name="landmark_1"><static>true</static><pose>-1.4 2.8 0.5 0 0 0</pose><link name="link">
      <collision name="c"><geometry><cylinder><radius>0.15</radius><length>1</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.15</radius><length>1</length></cylinder></geometry><material><ambient>1 .5 0 1</ambient></material></visual>
    </link></model>
    <model name="landmark_2"><static>true</static><pose>1.5 2.5 0.5 0 0 0</pose><link name="link">
      <collision name="c"><geometry><cylinder><radius>0.15</radius><length>1</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.15</radius><length>1</length></cylinder></geometry><material><ambient>1 .5 0 1</ambient></material></visual>
    </link></model>
    <model name="landmark_3"><static>true</static><pose>0.4 0.4 0.5 0 0 0</pose><link name="link">
      <collision name="c"><geometry><cylinder><radius>0.15</radius><length>1</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.15</radius><length>1</length></cylinder></geometry><material><ambient>1 .5 0 1</ambient></material></visual>
    </link></model>

    <model name="wall_n"><static>true</static><pose>0 5 0.5 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>10 .15 1</size></box></geometry></collision><visual name="v"><geometry><box><size>10 .15 1</size></box></geometry></visual>
    </link></model>
    <model name="wall_s"><static>true</static><pose>0 -5 0.5 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>10 .15 1</size></box></geometry></collision><visual name="v"><geometry><box><size>10 .15 1</size></box></geometry></visual>
    </link></model>
    <model name="wall_e"><static>true</static><pose>5 0 0.5 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>.15 10 1</size></box></geometry></collision><visual name="v"><geometry><box><size>.15 10 1</size></box></geometry></visual>
    </link></model>
    <model name="wall_w"><static>true</static><pose>-5 0 0.5 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>.15 10 1</size></box></geometry></collision><visual name="v"><geometry><box><size>.15 10 1</size></box></geometry></visual>
    </link></model>
    <model name="box_obstacle"><static>true</static><pose>0.5 -1.5 0.4 0 0 .35</pose><link name="l">
      <collision name="c"><geometry><box><size>1.2 .5 .8</size></box></geometry></collision><visual name="v"><geometry><box><size>1.2 .5 .8</size></box></geometry></visual>
    </link></model>
  </world>
</sdf>
